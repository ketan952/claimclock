{
  "name": "claimclock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && node scripts/prepare-sharing.mjs && astro build && node scripts/check-static-csp.mjs && node scripts/build-sw.mjs",
    "check:csp": "node scripts/check-static-csp.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && node scripts/validate-data.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "deploy": "wrangler deploy",
    "licenses": "node scripts/audit-licenses.mjs",
    "licenses:release": "node scripts/check-release-licenses.mjs",
    "test:browser": "playwright test",
    "data:check": "python3 scripts/parse-nl48.py --check",
    "lint": "node scripts/lint.mjs",
    "qa:performance": "node scripts/run-lighthouse.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.149.0"
  }
}
