---
import '../styles/global.css';
import {buildId} from '../../scripts/build-info.mjs';
import VoiceCopilot from '../components/VoiceCopilot.astro';
const { title = 'ClaimClock — a clock on your side', description = 'Keep a cashless insurance timeline, ask for written acknowledgement, and prepare your next message. Free and private.' } = Astro.props;
const origin='https://claimclock.ketan952.workers.dev';
const canonical=new URL(Astro.url.pathname,origin).href;
const card=Astro.url.pathname==='/index/'?'index':Astro.url.pathname.match(/^\/index\/([^/]+)\/?$/)?.[1]||'default';
---
<!doctype html>
<html lang="en">
<head>
  <meta name="claimclock-build" content={buildId} /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="theme-color" content="#183f35" />
  <title>{title}</title><link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="ClaimClock" /><meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={`${origin}/og/${card}.png`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${origin}/og/${card}.png`} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" /><link rel="icon" href="/icon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/manifest.webmanifest" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content / सीधे मुख्य भाग पर जाएँ</a>
  <header class="site-header"><div class="header-inner">
    <a class="brand" href="/"><img src="/icon.svg" width="31" height="31" alt="" />Claim<span>Clock</span><span class="beta">BETA</span></a>
    <nav aria-label="Main"><a href="/" data-i18n="nav.hospital">At the hospital</a><a href="/deductions/" data-i18n="nav.deductions">Paid less?</a><a href="/index/" data-i18n="nav.index">The Delay Index</a><a href="/vault/" data-i18n="nav.vault">My Vault</a></nav>
    <div class="language" aria-label="Language / भाषा"><button type="button" data-language="en" aria-pressed="true">EN</button><button type="button" data-language="hi" aria-pressed="false">हिन्दी</button></div>
  </div></header>
  <div id="offline-status" class="offline-status" role="status" hidden data-i18n="status.offline">You're offline. Your clock and saved messages still work.</div>
  <div id="update-toast" class="update-toast" role="status" hidden><button type="button" id="update-reload" data-i18n="status.updated">Updated — reload</button></div>
  <main id="main"><slot /></main>
  <footer class="site-footer"><div><a class="brand small" href="/">ClaimClock</a><p data-i18n="footer.built">Made for the wait. Built for your privacy.</p></div><div class="footer-links"><a href="/check-coverage/" data-i18n="footer.coverage">Is this covered?</a><a href="/compare/" data-i18n="footer.compare">Compare plans</a><a href="/renewal/" data-i18n="footer.renewal">Renewal Guardian</a><a href="/about/" data-i18n="nav.about">How it works</a><a href="/privacy/" data-i18n="privacy.link">Privacy & data</a><a href="https://github.com/ketan952/claimclock" data-i18n="footer.source">Open source · AGPL-3.0</a></div><p class="disclaimer" data-i18n="footer.disclaimer">Information, not legal advice. ClaimClock does not file complaints or guarantee a claim outcome.</p></footer>
  <VoiceCopilot />
  <div id="print-root" aria-hidden="true"></div>
  <script>
    import {initI18n} from '../lib/i18n';
    import '../lib/select-picker';
    initI18n();
    const offline=document.querySelector<HTMLElement>('#offline-status')!;
    const connectivity=()=>offline.hidden=navigator.onLine;
    window.addEventListener('online',connectivity);window.addEventListener('offline',connectivity);connectivity();
    if('serviceWorker' in navigator && import.meta.env.PROD){
      let controlled=Boolean(navigator.serviceWorker.controller);
      navigator.serviceWorker.addEventListener('controllerchange',()=>{if(controlled)document.querySelector<HTMLElement>('#update-toast')!.hidden=false;controlled=true;});
      document.querySelector('#update-reload')?.addEventListener('click',()=>location.reload());
      window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js',{updateViaCache:'none'}).then(reg=>reg.update()).catch(()=>{}));
    }
    document.querySelectorAll('nav a').forEach(a=>{if(new URL((a as HTMLAnchorElement).href).pathname===location.pathname)a.setAttribute('aria-current','page')});
    // ClaimClock Voice (M22) loads on the first tap only; nothing about the microphone runs before then.
    const voiceLaunch=document.querySelector<HTMLButtonElement>('#voice-launch');
    voiceLaunch?.addEventListener('click',async()=>{voiceLaunch.disabled=true;try{const voice=await import('../lib/voice-ui');await voice.openVoice();}catch{/* the module could not load (offline, uncached); the button simply re-enables */}finally{voiceLaunch.disabled=false;}});
  </script>
</body>
</html>
