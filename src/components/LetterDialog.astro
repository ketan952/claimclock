<dialog id="letter-dialog" aria-labelledby="letter-title">
  <div class="dialog-top"><h2 id="letter-title" data-i18n="letter.title">Your message, ready to review</h2><button class="dialog-close" id="letter-close" aria-label="Close" data-i18n-aria-label="letter.close">×</button></div>
  <p class="letter-note" data-i18n="letter.note">Check the details. Add your name and claim ID yourself before sending. You are the complainant.</p>
  <p id="letter-subject" class="letter-subject"></p>
  <label class="sr-only" for="letter-body" data-i18n="letter.message">Message</label><textarea id="letter-body" spellcheck="false"></textarea>
  <div class="button-row"><button class="button" id="letter-copy" data-i18n="letter.copy">Copy message</button><a class="button-secondary" id="letter-whatsapp" target="_blank" rel="noopener noreferrer" data-i18n="letter.whatsapp">Share to WhatsApp</a><a class="button-secondary" id="letter-email" data-i18n="letter.email">Open email</a><a class="button-secondary" id="letter-portal" href="https://bimabharosa.irdai.gov.in/" target="_blank" rel="noopener noreferrer" hidden data-i18n="letter.portal">Open Bima Bharosa portal</a><a class="button-secondary" id="letter-ombudsman-portal" href="https://www.cioins.co.in/" target="_blank" rel="noopener noreferrer" hidden data-i18n="letter.ombudsmanPortal">Open Ombudsman portal</a><button class="text-button" id="letter-download" data-i18n="letter.download">Download text</button></div>
  <p class="status" id="letter-status" role="status"></p>
  <p id="bima-character-count" class="fine-print" role="status" hidden></p>
  <div class="source-note" id="bima-instructions" hidden><strong data-i18n="bima.steps">You file the complaint</strong><p data-i18n="bima.body">First complain to your insurer's GRO. Keep the acknowledgement.</p><a href="https://bimabharosa.irdai.gov.in/" target="_blank" rel="noopener noreferrer">Bima Bharosa ↗</a></div>
</dialog>
