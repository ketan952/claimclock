---
// Saathi — ClaimClock's voice companion (M22). Static markup only; behaviour loads on first tap
// from src/lib/voice-ui.ts. The microphone is never requested before the consent step.
import en from '../i18n/en.json';
---
<button type="button" id="voice-launch" class="saathi-launch" aria-haspopup="dialog" aria-controls="voice-dialog" data-i18n-aria-label="voice.launch" aria-label={en['voice.launch']}>
 <span class="saathi-dot" aria-hidden="true"></span>
 <span data-i18n="voice.launchLabel">{en['voice.launchLabel']}</span>
</button>
<dialog id="voice-dialog" class="saathi" aria-labelledby="voice-title">
 <header class="saathi-head">
  <span class="saathi-avatar" aria-hidden="true"></span>
  <div class="saathi-head-text"><h2 id="voice-title" data-i18n="voice.title">{en['voice.title']}</h2><p data-i18n="voice.subtitle">{en['voice.subtitle']}</p></div>
  <button type="button" id="voice-close" class="saathi-close" data-i18n-aria-label="voice.close" aria-label={en['voice.close']}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M18.3 5.7a1 1 0 0 0-1.4 0L12 10.6 7.1 5.7a1 1 0 1 0-1.4 1.4l4.9 4.9-4.9 4.9a1 1 0 1 0 1.4 1.4l4.9-4.9 4.9 4.9a1 1 0 0 0 1.4-1.4L13.4 12l4.9-4.9a1 1 0 0 0 0-1.4Z"/></svg></button>
 </header>
 <section id="voice-consent" class="saathi-consent">
  <p class="saathi-greeting" data-i18n="voice.greeting">{en['voice.greeting']}</p>
  <p class="saathi-summary" data-i18n="voice.consentSummary">{en['voice.consentSummary']}</p>
  <details class="saathi-details"><summary data-i18n="voice.consentDetails">{en['voice.consentDetails']}</summary>
   <ul>
    <li data-i18n="voice.consentAudio">{en['voice.consentAudio']}</li>
    <li data-i18n="voice.consentText">{en['voice.consentText']}</li>
    <li data-i18n="voice.consentNothingStored">{en['voice.consentNothingStored']}</li>
    <li data-i18n="voice.consentAdvisory">{en['voice.consentAdvisory']}</li>
   </ul>
   <p class="fine-print"><a href="/privacy/#voice" data-i18n="voice.privacyLink">{en['voice.privacyLink']}</a></p>
  </details>
  <p id="voice-unavailable" class="status error" role="status" hidden></p>
  <label class="checkbox-label saathi-check"><input type="checkbox" id="voice-consent-box" /><span data-i18n="voice.consentCheck">{en['voice.consentCheck']}</span></label>
  <div class="saathi-actions">
   <button type="button" id="voice-start" class="button saathi-primary" disabled><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 15a4 4 0 0 0 4-4V6a4 4 0 1 0-8 0v5a4 4 0 0 0 4 4Zm6-4a1 1 0 1 1 2 0 8 8 0 0 1-7 7.94V21h2a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2h2v-2.06A8 8 0 0 1 4 11a1 1 0 1 1 2 0 6 6 0 0 0 12 0Z"/></svg><span data-i18n="voice.start">{en['voice.start']}</span></button>
   <button type="button" id="voice-text-only" class="button-secondary" disabled data-i18n="voice.textOnly">{en['voice.textOnly']}</button>
  </div>
 </section>
 <section id="voice-session" hidden>
  <div class="saathi-scroll">
  <div class="saathi-stage">
   <canvas id="voice-orb" width="220" height="220" aria-hidden="true"></canvas>
   <p id="voice-state" class="saathi-state" role="status" aria-live="polite"></p>
  </div>
  <div id="voice-chips" class="saathi-chips" role="group" aria-label={en['voice.chipsLabel']} data-i18n-aria-label="voice.chipsLabel">
   <button type="button" class="saathi-chip" data-i18n="voice.chip.benefit">{en['voice.chip.benefit']}</button>
   <button type="button" class="saathi-chip" data-i18n="voice.chip.clock">{en['voice.chip.clock']}</button>
   <button type="button" class="saathi-chip" data-i18n="voice.chip.room">{en['voice.chip.room']}</button>
   <button type="button" class="saathi-chip" data-i18n="voice.chip.letter">{en['voice.chip.letter']}</button>
   <button type="button" class="saathi-chip" data-i18n="voice.chip.policy">{en['voice.chip.policy']}</button>
   <button type="button" class="saathi-chip" data-i18n="voice.chip.renewal">{en['voice.chip.renewal']}</button>
  </div>
  <ol id="voice-log" class="saathi-log" aria-live="polite" aria-label={en['voice.transcript']} data-i18n-aria-label="voice.transcript"></ol>
  <div id="voice-cards" class="saathi-cards"></div>
  </div>
  <div class="saathi-dock">
  <div class="saathi-controls">
   <label class="saathi-switch"><input type="checkbox" id="voice-handsfree" checked /><span class="saathi-switch-track" aria-hidden="true"></span><span data-i18n="voice.handsFree">{en['voice.handsFree']}</span></label>
   <button type="button" id="voice-talk" class="saathi-mic" data-i18n-aria-label="voice.talk" aria-label={en['voice.talk']}><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 15a4 4 0 0 0 4-4V6a4 4 0 1 0-8 0v5a4 4 0 0 0 4 4Zm6-4a1 1 0 1 1 2 0 8 8 0 0 1-7 7.94V21h2a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2h2v-2.06A8 8 0 0 1 4 11a1 1 0 1 1 2 0 6 6 0 0 0 12 0Z"/></svg></button>
   <button type="button" id="voice-stop" class="button-secondary saathi-stop" hidden data-i18n="voice.stopSpeaking">{en['voice.stopSpeaking']}</button>
  </div>
  <p id="voice-talk-label" class="saathi-mic-label" aria-hidden="true"></p>
  <form id="voice-text-form" class="saathi-text"><input name="text" type="text" maxlength="1500" autocomplete="off" placeholder={en['voice.typePlaceholder']} data-i18n-placeholder="voice.typePlaceholder" aria-label={en['voice.typePlaceholder']} data-i18n-aria-label="voice.typePlaceholder" /><button type="submit" class="saathi-send" data-i18n-aria-label="voice.send" aria-label={en['voice.send']}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12 2-12 2z"/></svg></button></form>
  <p id="voice-error" class="status error" role="alert"></p>
  <p class="fine-print saathi-foot" data-i18n="voice.footnote">{en['voice.footnote']}</p>
  </div>
 </section>
</dialog>
<style is:global>
 :root{--saathi-a:#1f6b57;--saathi-b:#7e9464;--saathi-c:#d9c56a;--saathi-ink:#183f35}
 .saathi-launch{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:40;display:inline-flex;align-items:center;gap:10px;padding:10px 18px 10px 12px;border-radius:999px;background:var(--saathi-ink);color:#fff;font-weight:700;font-size:.92rem;letter-spacing:.01em;box-shadow:0 12px 28px rgb(24 63 53 / .32);border:0;transition:transform .18s ease,box-shadow .18s ease}
 .saathi-launch:hover{transform:translateY(-1px);box-shadow:0 16px 32px rgb(24 63 53 / .36)}.saathi-launch:focus-visible{outline:3px solid var(--saathi-b);outline-offset:3px}
 .saathi-dot{position:relative;width:22px;height:22px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff8 0,#fff0 40%),conic-gradient(from 200deg,var(--saathi-c),var(--saathi-b),var(--saathi-a),var(--saathi-c));flex-shrink:0}
 .saathi-dot::after{content:"";position:absolute;inset:-5px;border-radius:50%;border:2px solid #ffffff66;animation:saathiPing 2.4s ease-out infinite}
 @keyframes saathiPing{0%{transform:scale(.7);opacity:.9}70%{transform:scale(1.25);opacity:0}100%{opacity:0}}
 dialog.saathi{padding:0;border:0;background:#fbfaf6;color:var(--ink);width:min(560px,calc(100% - 24px));max-height:92dvh;border-radius:24px;box-shadow:0 30px 80px rgb(15 35 28 / .35);display:none;flex-direction:column;overflow:hidden}
 dialog.saathi[open]{display:flex;animation:saathiIn .32s cubic-bezier(.2,.8,.2,1)}
 dialog.saathi::backdrop{background:rgb(15 35 28 / .45);backdrop-filter:blur(4px)}
 @keyframes saathiIn{from{opacity:0;transform:translateY(24px) scale(.98)}to{opacity:1;transform:none}}
 .saathi-head{display:flex;align-items:center;gap:12px;padding:16px 16px 12px 20px;background:linear-gradient(180deg,#eef2e6,#fbfaf6)}
 .saathi-avatar{width:40px;height:40px;border-radius:50%;flex-shrink:0;background:radial-gradient(circle at 35% 30%,#fff9 0,#fff0 42%),conic-gradient(from 200deg,var(--saathi-c),var(--saathi-b),var(--saathi-a),var(--saathi-c));box-shadow:0 6px 16px rgb(31 107 87 / .3)}
 .saathi-head-text{flex:1;min-width:0}.saathi-head-text h2{margin:0;font-size:1.25rem;line-height:1.2}.saathi-head-text p{margin:2px 0 0;font-size:.82rem;color:#5d6b54}
 .saathi-close{width:40px;height:40px;border-radius:50%;background:#ffffffaa;color:var(--saathi-ink);display:grid;place-items:center;padding:0;border:0}.saathi-close:hover{background:#fff}
 .saathi-consent{padding:4px 20px 18px;overflow:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:12px}
 #voice-session{display:flex;flex-direction:column;min-height:0;flex:1}
 .saathi-scroll{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:4px 20px 10px;display:flex;flex-direction:column;gap:12px}
 .saathi-dock{padding:10px 20px 14px;border-top:1px solid var(--line);background:#fbfaf6;display:flex;flex-direction:column;gap:8px;flex-shrink:0}
 dialog.saathi.in-session{height:min(760px,92dvh)}
 dialog.saathi[data-has-log] #voice-orb{width:84px;height:84px}
 dialog.saathi[data-has-log] .saathi-stage{margin-top:0}
 .saathi-greeting{margin:8px 0 0;font-size:1.12rem;line-height:1.45;font-weight:600;color:var(--saathi-ink)}
 .saathi-summary{margin:0;font-size:.94rem;line-height:1.55;color:#3f4b3b}
 .saathi-details{border:1px solid var(--line);border-radius:12px;padding:10px 14px;background:#fff}.saathi-details summary{cursor:pointer;font-weight:650;font-size:.9rem;color:var(--saathi-ink)}
 .saathi-details ul{margin:10px 0 4px;padding-left:18px;font-size:.88rem;line-height:1.55}.saathi-details li+li{margin-top:6px}.saathi-details .fine-print{margin:8px 0 0}
 .saathi-check{margin:0;font-size:.92rem}
 .saathi-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:2px}
 .saathi-primary{display:inline-flex;align-items:center;gap:8px}
 .saathi-stage{display:flex;flex-direction:column;align-items:center;gap:2px;margin-top:-4px}
 #voice-orb{width:150px;height:150px;display:block}
 .saathi-state{margin:0;font-weight:650;color:#365046;min-height:1.4em;text-align:center;font-size:.95rem}
 .saathi-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
 .saathi-chip{border:1px solid #cdd6c3;background:#fff;color:var(--saathi-ink);border-radius:999px;padding:8px 14px;font-size:.84rem;font-weight:600;line-height:1.2;text-align:left}.saathi-chip:hover{background:#eef2e6;border-color:var(--saathi-b)}
 .saathi-log{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;font-size:.96rem;line-height:1.5}
 .saathi-log:empty,.saathi-cards:empty{display:none}
 .saathi-log li{padding:10px 14px;border-radius:16px;max-width:86%;white-space:pre-wrap;overflow-wrap:anywhere;position:relative}
 .saathi-log li.user{align-self:flex-end;background:var(--saathi-ink);color:#fff;border-bottom-right-radius:5px}
 .saathi-log li.assistant{align-self:flex-start;background:#fff;border:1px solid var(--line);border-bottom-left-radius:5px;margin-left:26px}
 .saathi-log li.assistant::before{content:"";position:absolute;left:-26px;bottom:2px;width:18px;height:18px;border-radius:50%;background:conic-gradient(from 200deg,var(--saathi-c),var(--saathi-b),var(--saathi-a),var(--saathi-c))}
 .saathi-log li.assistant.live::after{content:"";display:inline-block;width:6px;height:6px;margin-left:6px;border-radius:50%;background:var(--saathi-b);animation:saathiBlink 1s ease-in-out infinite}
 @keyframes saathiBlink{50%{opacity:.2}}
 .saathi-cards{display:flex;flex-direction:column;gap:10px;margin-left:26px}
 .voice-card{border:1px solid var(--line);border-left:4px solid var(--saathi-b);border-radius:14px;padding:14px 16px;background:#fff}
 .voice-card h3{margin:0 0 8px;font-size:1rem}.voice-card ul{margin:0;padding-left:18px;font-size:.9rem;line-height:1.5}.voice-card ul li+li{margin-top:4px}
 .voice-card .voice-card-links{display:flex;flex-wrap:wrap;gap:12px 18px;margin-top:10px;font-size:.86rem}
 .voice-card .voice-letter-subject{display:block;margin:10px 0 6px;font-weight:650}
 .voice-card pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;font-size:.86rem;line-height:1.5;margin:0;padding:12px;background:#fbfaf6;border:1px solid var(--line);border-radius:8px;max-height:36dvh;overflow:auto}
 .voice-card .button-row{margin-top:10px}
 .saathi-controls{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;margin-top:4px}
 .saathi-switch{display:inline-flex;align-items:center;gap:8px;font-size:.8rem;color:#3f4b3b;cursor:pointer;justify-self:start}.saathi-switch input{position:absolute;opacity:0;width:1px;height:1px}
 .saathi-switch-track{width:36px;height:20px;border-radius:999px;background:#c9d1c0;position:relative;transition:background .2s;flex-shrink:0}.saathi-switch-track::after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .2s;box-shadow:0 1px 3px rgb(0 0 0 / .3)}
 .saathi-switch input:checked+.saathi-switch-track{background:var(--saathi-a)}.saathi-switch input:checked+.saathi-switch-track::after{transform:translateX(16px)}.saathi-switch input:focus-visible+.saathi-switch-track{outline:3px solid var(--saathi-b);outline-offset:2px}
 .saathi-mic{width:68px;height:68px;border-radius:50%;border:0;padding:0;display:grid;place-items:center;background:var(--saathi-ink);color:#fff;box-shadow:0 10px 24px rgb(24 63 53 / .32);transition:transform .15s ease,background .2s;justify-self:center}
 .saathi-mic:hover{transform:scale(1.04)}.saathi-mic:disabled{background:#9aa49a;box-shadow:none;transform:none}.saathi-mic[hidden]{display:none}
 dialog.saathi[data-voice-state=recording] .saathi-mic{background:#b04a3a;animation:saathiPulse 1.2s ease-in-out infinite}
 @keyframes saathiPulse{50%{box-shadow:0 0 0 14px rgb(176 74 58 / .18)}}
 .saathi-stop{justify-self:end}
 .saathi-mic-label{margin:-6px 0 0;text-align:center;font-size:.8rem;color:#5d6b54;min-height:1.2em}
 .saathi-text{display:flex;gap:8px;align-items:center}.saathi-text input{flex:1;min-width:0;border-radius:999px;padding:12px 16px}
 .saathi-send{width:46px;height:46px;border-radius:50%;border:0;padding:0;display:grid;place-items:center;background:#eef2e6;color:var(--saathi-ink);flex-shrink:0}.saathi-send:hover{background:#dfe6d3}
 #voice-error:empty{display:none}
 .saathi-foot{margin:0;text-align:center}
 @media(max-width:759px){dialog.saathi{position:fixed;inset:auto 0 0 0;margin:0;width:100%;max-width:none;border-radius:24px 24px 0 0;max-height:94dvh}dialog.saathi.in-session{height:94dvh}dialog.saathi[open]{animation:saathiUp .34s cubic-bezier(.2,.8,.2,1)}@keyframes saathiUp{from{transform:translateY(100%)}to{transform:none}}.saathi-consent{padding:4px 16px calc(14px + env(safe-area-inset-bottom))}.saathi-scroll{padding:4px 16px 10px}.saathi-dock{padding:10px 16px calc(12px + env(safe-area-inset-bottom))}#voice-orb{width:128px;height:128px}.site-footer{padding-bottom:88px}}
 @media(max-width:480px){.saathi-launch span:last-child{display:none}.saathi-launch{padding:12px}}
 @media(prefers-reduced-motion:reduce){.saathi-dot::after,.saathi-log li.assistant.live::after,dialog.saathi[data-voice-state=recording] .saathi-mic{animation:none}dialog.saathi[open]{animation:none}}
 @media print{.saathi-launch,dialog.saathi{display:none !important}}
</style>
