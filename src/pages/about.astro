---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
---
<Base title="How ClaimClock works"><div class="wrap prose"><p class="eyebrow">ClaimClock</p><h1 data-i18n="about.title">Three small steps. A stronger record.</h1><div class="steps">{['one','two','three'].map((key,i)=><article class="card"><span class="step-number">0{i+1}</span><h2 data-i18n={`about.${key}`}>{en[`about.${key}` as keyof typeof en]}</h2><p data-i18n={`about.${key}Body`}>{en[`about.${key}Body` as keyof typeof en]}</p></article>)}</div><p class="notice" style="margin-top:30px" data-i18n="about.limit">{en['about.limit']}</p><div class="button-row"><a class="button" href="/" data-i18n="start.button">Start my clock</a><a href="/index/" data-i18n="nav.index">The Delay Index</a></div><h2 id="escalation" data-i18n="about.escalation">Escalation routes</h2><ol><li data-i18n="rejection.gro">{en['rejection.gro']}</li><li><p data-i18n="rejection.bima">{en['rejection.bima']}</p><a href="https://bimabharosa.irdai.gov.in/">Bima Bharosa ↗</a></li><li><p data-i18n="rejection.ombudsman">{en['rejection.ombudsman']}</p><a href="https://www.cioins.co.in/Faqs" data-i18n="rejection.eligibility">Check Ombudsman eligibility</a></li><li><p data-i18n="rejection.consumer">{en['rejection.consumer']}</p><a href="https://e-jagriti.gov.in/">e-Jagriti ↗</a></li></ol><p class="fine-print"><span data-i18n="about.rules">Primary rules and limitations</span>: <a href="/data/rules.json">rules.json</a>. <span data-i18n="about.eligibilityLimit">{en['about.eligibilityLimit']}</span></p></div></Base>
