---
import Base from '../layouts/Base.astro';
import LetterDialog from '../components/LetterDialog.astro';
import contacts from '../../data/contacts.json';
---
<Base title="Understand claim deductions — ClaimClock"><div class="wrap"><section class="page-hero"><p class="eyebrow" data-i18n="deductions.eyebrow">EVERY LINE DESERVES A REASON</p><h1 data-i18n="deductions.title">Make the deductions add up.</h1><p class="lead" data-i18n="deductions.body">Read your settlement letter on this device. Check each line, then ask for a clear reason and the policy clause.</p></section><div class="notice" data-i18n="deductions.caution">This checks explanations, not your medical eligibility. Policy wording and the actual calculation decide whether a deduction applies.</div>
<section class="card"><h2 data-i18n="cases.attachTitle">Keep these lines with a local case</h2><label><span data-i18n="cases.choose">Current case</span><select id="deduction-case" disabled></select></label><div class="button-row"><button type="button" class="button-secondary" id="deduction-load" disabled data-i18n="cases.loadLines">Load saved deduction lines</button><button type="button" class="button-secondary" id="deduction-save" disabled data-i18n="cases.saveLines">Attach reviewed lines to this case</button></div><p class="fine-print" data-i18n="cases.attachNote">Only reviewed lines and your policy confirmations are saved. Original files and extracted text stay on this page.</p><p id="deduction-case-status" class="status" role="status"></p><a href="/" data-i18n="cases.manage">Manage local cases or restore a backup</a></section><div class="index-columns"><div class="stack">
 <section class="card"><p class="section-number" data-i18n="deductions.sectionRead">01 / READ ON DEVICE</p><h2 data-i18n="deductions.upload">Add your documents</h2><p data-i18n="deductions.uploadNote">Optional. PDF or photo; up to 20 MB and 20 pages per file. English OCR. Manual entry always works.</p><div class="form-grid"><label class="full"><span data-i18n="deductions.settlement">Settlement / deduction letter</span><input type="file" id="settlement-file" accept="application/pdf,image/png,image/jpeg,image/webp" /></label><label class="full"><span data-i18n="deductions.bill">Itemised hospital bill</span><input type="file" id="bill-file" accept="application/pdf,image/png,image/jpeg,image/webp" /></label><label class="full"><span data-i18n="deductions.policy">Policy schedule (optional)</span><input type="file" id="policy-file" accept="application/pdf,image/png,image/jpeg,image/webp" /></label></div><p class="status" id="extract-status" role="status"></p><details id="extracted-details"><summary data-i18n="deductions.extracted">Read and correct extracted text</summary><label><span data-i18n="deductions.text">Document text — stays on this page</span><textarea id="extracted-text" rows="9" spellcheck="false"></textarea></label><p class="fine-print" data-i18n="deductions.ocrWarning">OCR can miss amounts and rows. Check against the original. No diagnosis is inferred.</p></details></section>
 <section class="card"><p class="section-number" data-i18n="deductions.sectionLines">02 / CHECK THE LINES</p><h2 data-i18n="deductions.enter">Enter or correct each deduction</h2><p data-i18n="deductions.format">One line per deduction: reason | amount in rupees. Use the deducted amount, not the whole bill.</p><form id="deduction-form" class="form-grid"><label class="full"><span data-i18n="label.insurer">Your insurer</span><select name="insurer" required><option value="" data-i18n="label.choose">Choose your insurer</option>{contacts.filter(c=>c.kind==='insurer').map(c=><option value={c.id}>{c.name}</option>)}</select></label><label class="full"><span data-i18n="deductions.lines">Deduction lines</span><textarea name="lines" id="deduction-lines" rows="6" required data-i18n-placeholder="deductions.placeholder" placeholder="Proportionate room rent | 4200&#10;Unexplained adjustment | 1500"></textarea></label><label class="checkbox-label full"><input name="confirmed" type="checkbox" required /><span data-i18n="deductions.confirm">I checked the reasons and amounts against my documents.</span></label><p class="error full" id="deduction-error" role="alert"></p><button class="button full" disabled data-i18n="deductions.review">Review my deductions</button></form></section>
 <section class="card" id="deduction-results" hidden><p class="section-number" data-i18n="deductions.sectionReview">03 / ASK FOR A REVIEW</p><h2 data-i18n="deductions.results">Your line-by-line review</h2><p class="fine-print" data-i18n="deductions.resultsNote">“Challengeable” means ask for evidence and review. It does not mean a refund is owed.</p><div id="deduction-cards"></div><p id="deduction-total"></p><div class="button-row"><button class="button" id="reconsideration" data-i18n="deductions.letter">Prepare reconsideration letter</button><button class="button-secondary" id="deduction-bima" data-i18n="clock.bima">Prepare a Bima Bharosa complaint</button></div></section>
</div><aside class="stack">
 <section class="card rights-card"><h2 data-i18n="deductions.noAi">A reason. A clause. A calculation.</h2><p data-i18n="deductions.noAiBody">You can request these without AI. No medical document needs to leave your phone.</p><div class="source-note"><a href="https://irdai.gov.in/document-detail?documentId=4942918">IRDAI §17(b) ↗</a></div></section>
 <section class="card" id="ai-section"><h2 data-i18n="deductions.ai">Optional: explain an unclear line</h2><p data-i18n="deductions.aiNote">Only the preview below is sent to the configured AI provider. Check that names, policy numbers and UHIDs are removed. Automatic redaction can miss details.</p><p class="fine-print" id="ai-provider"></p><button class="button-secondary" id="prepare-ai" data-i18n="deductions.previewAi">Prepare a redacted preview</button><form id="ai-form" hidden><label style="margin-top:16px"><span data-i18n="deductions.aiPreview">The exact text that will be sent</span><textarea id="ai-preview" maxlength="800" rows="5" required></textarea></label><label class="checkbox-label" style="margin-top:16px"><input name="consent" type="checkbox" required /><span data-i18n="deductions.aiConsent">I checked this text contains no identifying details and consent to sending it for this explanation.</span></label><button class="button" style="margin-top:16px" disabled data-i18n="deductions.explain">Explain with AI</button></form><p id="ai-status" class="status" role="status"></p><p id="ai-output"></p></section>
 <section class="card"><h2 data-i18n="deductions.reminders">Keep track of complaint dates</h2><p data-i18n="deductions.reminderNote">Downloads reminders for day 14, day 30, and a provisional one-year limit. Verify the actual Ombudsman trigger; a reminder does not file a complaint.</p><form id="reminder-form" class="form-grid"><label class="full"><span data-i18n="deductions.complaintDate">Date you complained to the insurer</span><input name="complaintDate" type="date" required /></label><label class="full"><span data-i18n="deductions.responseDate">Rejection / unsatisfactory reply date (if any)</span><input name="responseDate" type="date" /></label><button class="button-secondary full" disabled data-i18n="deductions.calendar">Download calendar reminders (.ics)</button><p class="status full" id="reminder-status" role="status"></p></form><a href="https://www.cioins.co.in/Faqs" class="fine-print" data-i18n="deductions.ombudsmanLink">Ombudsman eligibility ↗</a></section>
 <a href="/rejected/" class="death-link" data-i18n="deductions.rejected">Was the whole claim rejected? →</a>
</aside></div><p class="fine-print" data-i18n="deductions.close">Document text is held in this page's memory. Close or reload to clear it.</p><div class="empty-note"></div></div><LetterDialog/><script>import '../lib/deduction-ui';</script></Base>
