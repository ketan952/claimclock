---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
import sourceLinks from '../../data/source-links.json';
---
<Base title="Index methodology — ClaimClock"><div class="wrap narrow prose"><p class="eyebrow" data-i18n="method.eyebrow">READ THE NUMBERS CAREFULLY</p><h1 data-i18n="method.title">How we read NL-48</h1><p data-i18n="method.intro">{en['method.intro']}</p><h2 data-i18n="method.limits">What these figures show</h2><ul>{['bucket','clock','rows','sample','coverage','patients'].map(key=><li data-i18n={`method.${key}`}>{en[`method.${key}` as keyof typeof en]}</li>)}</ul><h2 data-i18n="method.audit">Audit the dataset</h2><p data-i18n="method.auditBody">{en['method.auditBody']}</p><div class="button-row"><a class="button-secondary" href="/data/nl48.csv" download>CSV ↓</a><a class="button-secondary" href="/data/nl48.json" download>JSON ↓</a><a href="/data/filings.json" data-i18n="method.register">Coverage register</a></div><p><a href="https://github.com/ketan952/claimclock/blob/main/research/nl48-methodology.md" data-i18n="method.detail">Detailed source methodology and QA</a></p><h2 data-i18n="sources.title">Primary sources behind letter links</h2><p data-i18n="sources.body">Short links in your letters redirect to these original IRDAI documents.</p>{sourceLinks.map(source=><details><summary data-i18n={`sources.${source.slug}`}>{source.title_en}</summary><a class="source-url" href={source.url} target="_blank" rel="noopener noreferrer">{source.url}</a><p><a href={`/s/${source.slug}`}>/s/{source.slug}</a> · 302</p></details>)}<h2 data-i18n="method.corrections">Corrections</h2><p data-i18n="method.correctionsBody">{en['method.correctionsBody']}</p></div></Base>
