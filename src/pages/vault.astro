---
import Base from '../layouts/Base.astro';
import contacts from '../../data/contacts.json';
const insurers=contacts.filter(c=>c.kind==='insurer').sort((a,b)=>a.name.localeCompare(b.name));
---
<Base title="My Vault — ClaimClock" description="Save your name, family and policies on your device so every letter fills itself. Optional passkey account with client-side encrypted sync."><div class="wrap">
 <section class="page-hero"><p class="eyebrow" data-i18n="vault.eyebrow">YOUR DETAILS. YOUR DEVICE.</p><h1 data-i18n="vault.title">My Vault</h1><p class="lead" data-i18n="vault.lead">Save your name, family members and policies once. Every letter fills itself, and the clock knows your insurer. Nothing leaves this device unless you create a passkey account — and even then, only an encrypted copy does.</p></section>
 <p id="vault-status" class="status" role="status"></p>
 <div class="index-columns"><div class="stack">
  <section class="card" id="profile-card"><p class="section-number" data-i18n="vault.sectionProfile">01 / ABOUT YOU</p><h2 data-i18n="vault.profileTitle">Your name and city</h2><p data-i18n="vault.profileBody">Used to fill “Name” in every letter. Leave blank to keep writing it yourself.</p>
   <form id="profile-form" class="form-grid"><label><span data-i18n="vault.name">Full name (as on the policy)</span><input name="name" maxlength="100" autocomplete="name" /></label><label><span data-i18n="label.city">City</span><input name="city" maxlength="70" autocomplete="address-level2" /></label><label class="full"><span data-i18n="vault.language">Preferred language for letters</span><select name="language"><option value="en">English</option><option value="hi">हिन्दी</option></select></label><button type="submit" class="button-secondary full" disabled data-i18n="vault.save">Save</button><p id="profile-status" class="status full" role="status"></p></form></section>
  <section class="card" id="family-card"><p class="section-number" data-i18n="vault.sectionFamily">02 / FAMILY</p><h2 data-i18n="vault.familyTitle">Family members</h2><p data-i18n="vault.familyBody">Add everyone a policy covers. Health conditions stay on this device and are never sent anywhere in plain text.</p>
   <div id="members-list"></div>
   <form id="member-form" class="form-grid"><input type="hidden" name="memberId" /><label><span data-i18n="vault.memberName">Name</span><input name="name" maxlength="100" required autocomplete="off" /></label><label><span data-i18n="vault.relationLabel">Relation to you</span><select name="relation"><option value="self" data-i18n="vault.relation.self">Self</option><option value="spouse" data-i18n="vault.relation.spouse">Spouse</option><option value="child" data-i18n="vault.relation.child">Child</option><option value="parent" data-i18n="vault.relation.parent">Parent</option><option value="parent-in-law" data-i18n="vault.relation.parent-in-law">Parent-in-law</option><option value="other" data-i18n="vault.relation.other">Other</option></select></label><label><span data-i18n="vault.birthYear">Year of birth</span><input name="birthYear" type="number" min="1900" max="2026" inputmode="numeric" /><small data-i18n="label.optional">Optional</small></label><label><span data-i18n="vault.conditions">Known conditions</span><input name="conditions" maxlength="300" autocomplete="off" /><small data-i18n="vault.conditionsHint">Optional, e.g. diabetes, hypertension — helps with waiting-period checks later.</small></label><div class="full button-row"><button type="submit" class="button-secondary" disabled data-i18n="vault.addMember">Save member</button><button type="button" class="text-button" id="member-cancel" hidden data-i18n="vault.cancel">Cancel</button></div><p id="member-status" class="status full" role="status"></p></form></section>
  <section class="card" id="policies-card"><p class="section-number" data-i18n="vault.sectionPolicies">03 / POLICIES</p><h2 data-i18n="vault.policiesTitle">Your policies</h2><p data-i18n="vault.policiesBody">Health, life and motor. Pick the plan from the catalogue to load its published rules, or read them from your policy schedule on this device.</p>
   <div id="policies-list"></div>
   <form id="policy-form" class="form-grid"><input type="hidden" name="policyId" />
    <label class="full"><span data-i18n="vault.uploadSchedule">Read my policy schedule or CIS (PDF or photo — stays on this device)</span><input type="file" id="policy-file" accept="application/pdf,image/png,image/jpeg,image/webp" disabled /><small data-i18n="vault.uploadHint">Fills the blanks below. Check every value against your document before saving.</small><small class="status" id="policy-parse-status" role="status"></small></label>
    <label><span data-i18n="vault.kindLabel">Type of policy</span><select name="kind"><option value="health" data-i18n="vault.kind.health">Health</option><option value="life" data-i18n="vault.kind.life">Life</option><option value="motor" data-i18n="vault.kind.motor">Motor</option></select></label>
    <label><span data-i18n="label.insurer">Your insurer</span><select data-searchable name="insurerId" required><option value="" data-i18n="label.choose">Choose your insurer</option>{insurers.map(c=><option value={c.id} data-search={c.name_hi}>{c.name}</option>)}<option value="unlisted" data-i18n="label.unlisted">Other / not listed</option></select></label>
    <label class="full"><span data-i18n="vault.plan">Plan</span><select name="planId"></select></label>
    <div id="plan-rules" class="full"></div>
    <label class="full" id="plan-name-field"><span data-i18n="vault.planName">Plan name (if not in the list)</span><input name="planName" maxlength="120" autocomplete="off" /></label>
    <label><span data-i18n="vault.policyNumber">Policy number</span><input name="policyNumber" maxlength="60" autocomplete="off" /></label><label><span data-i18n="vault.sumInsured">Sum insured (₹)</span><input name="sumInsured" type="number" min="1" max="1000000000" step="1" inputmode="numeric" /></label>
    <label><span data-i18n="vault.inceptionDate">Current policy start date</span><input name="inceptionDate" type="date" /></label><label><span data-i18n="vault.renewalDate">Renewal / expiry date</span><input name="renewalDate" type="date" /></label>
    <label class="full"><span data-i18n="vault.continuityFrom">Continuous cover since (first policy, including ported or migrated years)</span><input name="continuityFrom" type="date" /><small data-i18n="vault.continuityHint">Waiting periods, the 60-month moratorium and the 36-month life shield count from here.</small></label>
    <fieldset class="full"><legend data-i18n="vault.coveredMembers">Who is covered</legend><div id="policy-members"></div></fieldset>
    <label><span data-i18n="vault.uhid">UHID / member ID</span><input name="uhid" maxlength="60" autocomplete="off" /></label><label><span data-i18n="vault.claimNumber">Current claim number</span><input name="claimNumber" maxlength="60" autocomplete="off" /><small data-i18n="vault.claimNumberHint">Optional; fills “Claim number” in letters while a claim is open.</small></label>
    <label class="checkbox-label full"><input type="checkbox" name="corporate" /><span data-i18n="vault.corporateLabel">This is an employer / group policy</span></label>
    <label><span data-i18n="vault.roomRent">Room rent rule</span><input name="roomRent" maxlength="120" autocomplete="off" /></label><label><span data-i18n="vault.copayPercent">Co-payment (%)</span><input name="copayPercent" type="number" min="0" max="100" step="0.5" inputmode="decimal" /></label>
    <label><span data-i18n="vault.consumablesLabel">Consumables / non-medical items</span><select name="consumables"><option value="" data-i18n="vault.consumables.unknown">Not sure</option><option value="included" data-i18n="vault.consumables.included">Covered in the plan</option><option value="rider" data-i18n="vault.consumables.rider">Covered by a rider / add-on</option><option value="excluded" data-i18n="vault.consumables.excluded">Not covered</option></select></label><label><span data-i18n="vault.healthCheckupLimit">Annual health check-up limit (₹)</span><input name="healthCheckupLimit" type="number" min="0" max="10000000" step="1" inputmode="numeric" /></label>
    <label><span data-i18n="vault.healthCheckupLastClaimedOn">Health check-up last used on</span><input name="healthCheckupLastClaimedOn" type="date" /></label><label><span data-i18n="vault.notes">Notes</span><input name="notes" maxlength="500" autocomplete="off" /></label>
    <label class="checkbox-label full"><input type="checkbox" name="isDefault" /><span data-i18n="vault.isDefault">Use this policy to fill letters when the insurer is not listed</span></label>
    <div class="full button-row"><button type="submit" class="button" disabled data-i18n="vault.addPolicy">Save policy</button><button type="button" class="text-button" id="policy-cancel" hidden data-i18n="vault.cancel">Cancel</button></div><p id="policy-status" class="status full" role="status"></p></form></section>
 </div><aside class="stack">
  <section class="card rights-card" id="account-card"><p class="section-number" data-i18n="vault.sectionAccount">OPTIONAL / SYNC</p><h2 data-i18n="vault.accountTitle">Keep it on every device</h2><p data-i18n="vault.accountBody">A passkey (fingerprint, face or device PIN) creates an account with no password, phone number or email. Your vault is encrypted on this device before it is stored; the server cannot read it.</p>
   <p id="account-summary" class="status" role="status"></p><p id="account-hint" class="fine-print" role="status"></p>
   <div class="button-row"><button type="button" class="button" id="account-register" disabled data-i18n="vault.register">Create a passkey account</button><button type="button" class="button-secondary" id="account-login" disabled data-i18n="vault.login">Sign in with passkey</button><button type="button" class="button-secondary" id="sync-now" disabled hidden data-i18n="vault.syncNow">Sync now</button><button type="button" class="text-button" id="account-logout" disabled hidden data-i18n="vault.logout">Sign out on this device</button></div>
   <p id="account-status" class="status" role="status"></p><p id="sync-summary" class="fine-print"></p><p id="sync-status" class="status" role="status"></p>
   <div id="sync-conflict" class="notice" hidden><p data-i18n="vault.conflictBody">Another device changed the synced vault after your last sync, and this device also has changes. Choose which copy to keep.</p><div class="button-row"><button type="button" class="button-secondary" id="conflict-use-server" disabled data-i18n="vault.useServer">Load the synced copy</button><button type="button" class="button-secondary" id="conflict-use-mine" disabled data-i18n="vault.useMine">Keep mine and overwrite</button></div></div>
   <div id="recovery-form-wrap" hidden><h3 data-i18n="vault.enterKeyTitle">Unlock your vault on this device</h3><p class="fine-print" data-i18n="vault.enterKeyBody">Your passkey signed you in, but this device does not have the vault key yet. Open the recovery link from your other device, or paste the recovery key here.</p><form id="recovery-form" autocomplete="off"><label><span data-i18n="vault.enterKeyLabel">Recovery link or key</span><input name="recovery" maxlength="2048" autocomplete="off" spellcheck="false" autocapitalize="off" required /></label><button type="submit" class="button-secondary" id="recovery-submit" disabled data-i18n="vault.enterKeySubmit">Unlock</button></form></div>
   <details id="recovery-panel" hidden><summary data-i18n="vault.recoveryTitle">Your recovery key</summary><p class="fine-print" data-i18n="vault.recoveryBody">This key decrypts your vault. Save it somewhere private (a password manager or a printed copy). Without it and without a synced passkey, a new device cannot read your vault — and neither can we.</p><label><span data-i18n="vault.recoveryKeyLabel">Recovery key</span><input id="recovery-key" type="password" readonly autocomplete="off" /></label><div class="button-row"><button type="button" class="text-button" id="recovery-show" disabled data-i18n="vault.showKey">Show / hide</button><button type="button" class="button-secondary" id="recovery-copy" disabled data-i18n="vault.copyKey">Copy recovery link</button></div><canvas id="recovery-qr" width="296" height="296" role="img" data-i18n-aria-label="vault.recoveryQrLabel" aria-label="Recovery link QR code"></canvas><p id="recovery-status" class="status" role="status"></p></details>
   <p class="fine-print" data-i18n="vault.privacyNote">Stored on the server: a random account id, your passkey’s public key, a hashed session token and the encrypted vault. Not stored: your name, policy numbers, health details or the key. You can delete the account and the synced copy at any time.</p>
   <button type="button" class="text-button" id="account-delete" disabled hidden data-i18n="vault.deleteAccount">Delete my account and the synced copy</button>
  </section>
  <section class="card" id="local-card"><h2 data-i18n="vault.localTitle">On this device</h2><p data-i18n="vault.localBody">Your vault is saved in this browser. Download a plain backup to move it by hand, or clear it.</p><div class="button-row"><button type="button" class="button-secondary" id="vault-export" disabled data-i18n="vault.export">Download vault backup</button></div><label style="margin-top:16px"><span data-i18n="vault.import">Restore a vault backup (JSON)</span><input type="file" id="vault-import-file" accept="application/json,.json" disabled /></label><div class="button-row"><button type="button" class="text-button" id="vault-clear" disabled data-i18n="vault.clear">Delete everything saved on this device</button></div></section>
 </aside></div>
</div><script>import '../lib/vault-ui';</script></Base>
<style>
 #recovery-qr{display:block;width:296px;max-width:100%;height:auto;margin:20px auto;background:white}#recovery-panel label,#recovery-form-wrap label{margin-top:12px}#recovery-key{font-family:monospace;font-size:.85rem}#plan-rules:empty{display:none}#plan-rules{background:#f0f2e7;padding:16px;border-radius:10px}#plan-rules h3{font-size:.95rem;margin-bottom:8px}#plan-rules p{margin-top:6px}#plan-rules a{font-size:.68rem;margin-left:4px}fieldset{border:1px solid var(--line);border-radius:9px;padding:12px 14px}legend{font-size:.875rem;font-weight:600;padding:0 6px}#policy-members label{margin-top:8px}#members-list .row-card:first-child,#policies-list .row-card:first-child{border-top:0}#account-card .button-row{margin-top:16px}
</style>
