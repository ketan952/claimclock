---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
---
<Base title="Privacy and your data — ClaimClock"><div class="wrap narrow prose"><p class="eyebrow" data-i18n="privacy.eyebrow">YOUR RECORD. YOUR CHOICE.</p><h1 data-i18n="privacy.title">Privacy & your data</h1><p data-i18n="privacy.intro">{en['privacy.intro']}</p><h2 data-i18n="privacy.leaves">What leaves the device</h2><ul><li data-i18n="privacy.sharing">{en['privacy.sharing']}</li><li data-i18n="privacy.ai">{en['privacy.ai']}</li><li data-i18n="privacy.reports">{en['privacy.reports']}</li></ul><p data-i18n="privacy.infrastructure">{en['privacy.infrastructure']}</p><h2 data-i18n="privacy.continuity">{en['privacy.continuity']}</h2><p data-i18n="privacy.continuityBody">{en['privacy.continuityBody']}</p><p><strong data-i18n="privacy.transfer">{en['privacy.transfer']}</strong></p><p data-i18n="privacy.transferBody">{en['privacy.transferBody']}</p><p data-i18n="privacy.transferRetention">{en['privacy.transferRetention']}</p><h2 data-i18n="privacy.turnstile">{en['privacy.turnstile']}</h2><p data-i18n="privacy.turnstileBody">{en['privacy.turnstileBody']}</p><p><a href="https://www.cloudflare.com/turnstile-privacy-policy/" data-i18n="privacy.turnstileLink">{en['privacy.turnstileLink']}</a></p><h2 data-i18n="privacy.publication">Publication and withdrawal</h2><p data-i18n="privacy.publicationBody">{en['privacy.publicationBody']}</p><p data-i18n="privacy.codeBody">{en['privacy.codeBody']}</p><form id="erase-report" class="card form-grid"><p class="full" data-i18n="privacy.receiptsBody">{en['privacy.receiptsBody']}</p><label class="full"><span data-i18n="privacy.savedReceipts">{en['privacy.savedReceipts']}</span><select id="saved-receipt"></select></label><p id="receipt-warning" class="status full" role="status"></p><label class="full"><span data-i18n="privacy.code">Deletion code</span><input name="code" required autocomplete="off" data-i18n-placeholder="privacy.codePlaceholder" placeholder="report-id:deletion-token" maxlength="200" /></label><button id="copy-saved-receipt" class="button-secondary full" type="button" disabled data-i18n="optin.copyCode">{en['optin.copyCode']}</button><p id="receipt-copy-status" class="status full" role="status"></p><button class="button-secondary full" type="submit" disabled data-i18n="privacy.erase">Erase my submitted report</button><p id="erase-status" class="status full" role="status"></p></form><h2 data-i18n="privacy.usage">Optional usage counts</h2><p data-i18n="privacy.usageBody">{en['privacy.usageBody']}</p><label class="checkbox-label"><input type="checkbox" id="analytics-consent" /><span data-i18n="privacy.analyticsConsent">{en['privacy.analyticsConsent']}</span></label><h2 data-i18n="privacy.localControls">Local controls</h2><p><a href="/" data-i18n="privacy.return">Return to your timeline</a></p><p data-i18n="privacy.localBody">{en['privacy.localBody']}</p><h2 data-i18n="privacy.contact">Contact and incidents</h2><p><span data-i18n="privacy.maintainer">{en['privacy.maintainer']}</span> <a href="mailto:ketangautam952@gmail.com">ketangautam952@gmail.com</a>. <span data-i18n="privacy.noDocuments">{en['privacy.noDocuments']}</span></p><p><a href="https://github.com/ketan952/claimclock/blob/main/docs/privacy-operations.md" data-i18n="privacy.incidentLink">Read the incident procedure</a></p><p data-i18n="privacy.incidentBody">{en['privacy.incidentBody']}</p><p class="fine-print" data-i18n="privacy.version">{en['privacy.version']}</p></div><script>import '../lib/privacy';</script></Base>
