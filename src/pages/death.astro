---
import Base from '../layouts/Base.astro';
import LetterDialog from '../components/LetterDialog.astro';
import rules from '../../data/rules.json';
const rule=rules.find(r=>r.id==='death-protocol')!;
---
<Base title="Immediate release after a death — ClaimClock"><div class="wrap narrow prose"><a href="/" class="fine-print" data-i18n="death.back">Back to the clock</a><h1 style="margin-top:25px" data-i18n="death.title">Help with release after a death</h1><p data-i18n="death.body">You do not need to manage a timer here. Ask the insurer and hospital desk to process the request immediately.</p><div class="source-note"><p>“{rule.quote}”</p><a href={rule.source_url}>{rule.paragraph} ↗</a></div><div class="button-row"><button class="button" id="death-message" data-i18n="death.message">Prepare the immediate-release message</button></div><p class="fine-print">Ask the hospital duty manager and insurer/TPA claims desk to coordinate directly. / अस्पताल के ड्यूटी मैनेजर और बीमा कंपनी/TPA से सीधे समन्वय करने को कहें।</p><p><a href="https://irdai.gov.in/list-of-gros" data-i18n="contact.directory">Official GRO directory</a></p></div><LetterDialog/><script>
import {setupLetterDialog} from '../lib/letter-dialog';import {loadTimeline} from '../lib/storage';import {makeLetter} from '../lib/letters';import {lang} from '../lib/i18n';import contacts from '../../data/contacts.json';import rules from '../../data/rules.json';import type {Contact,Rule,Timeline} from '../lib/types';
const open=setupLetterDialog();document.querySelector('#death-message')!.addEventListener('click',()=>{const timeline:Timeline=loadTimeline()||{id:crypto.randomUUID(),insurerId:'',hospital:'',city:'',requestType:'discharge',submittedAt:new Date().toISOString(),events:[]};open(makeLetter('death',timeline,contacts as Contact[],rules as Rule[],lang()));});
</script></Base>
