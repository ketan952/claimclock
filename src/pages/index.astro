---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
import LetterDialog from '../components/LetterDialog.astro';
import HospitalToolkits from '../components/HospitalToolkits.astro';
import Transfer from '../components/Transfer.astro';
import contacts from '../../data/contacts.json';
import rules from '../../data/rules.json';
const insurers=contacts.filter(c=>c.kind==='insurer').sort((a,b)=>a.name.localeCompare(b.name));
const tpas=contacts.filter(c=>c.kind==='tpa').sort((a,b)=>a.name.localeCompare(b.name));
const rights=['cashless-preauth','cashless-discharge','no-discharge-wait','delay-charges','documents-from-hospital'].map(id=>rules.find(r=>r.id===id)).filter(Boolean);
---
<Base>
<div class="wrap">
 <section id="intro">
  <div class="hero"><div><p class="eyebrow" data-i18n="tagline">TIME MATTERS. KEEP A RECORD.</p><h1 data-i18n="hero.title">A clock on your side.</h1><p class="lead" data-i18n="hero.body">Waiting for cashless approval? Save the time. Get it in writing. Know what to send next.</p><p class="privacy-hint"><span aria-hidden="true">◈</span><span data-i18n="hero.private">No login. Your hospital details stay on this device.</span></p></div><div class="hero-art" aria-hidden="true"><div class="clock-face"><span class="center"></span><span class="tick"></span></div><span class="art-note" data-i18n="hero.artNote">YOUR TIME COUNTS</span></div></div>
  <div class="stats-strip"><div class="stat"><strong data-i18n="strip.one">1 hour</strong><span data-i18n="strip.oneBody">for a cashless decision</span></div><div class="stat"><strong data-i18n="strip.three">3 hours</strong><span data-i18n="strip.threeBody">for final discharge authorisation</span></div><div class="stat"><strong data-i18n="strip.cost">₹0</strong><span data-i18n="strip.costBody">to use. No account needed.</span></div></div>
 </section>
 <div class="start-grid" id="start-view">
  <section class="card"><p class="section-number" data-i18n="start.section">01 / START HERE</p><h2 data-i18n="start.title">When did the desk send your request?</h2><p data-i18n="start.subtitle">Use the time the hospital says it submitted to the insurer or TPA.</p>
   <form id="start-form" class="form-grid">
    <label class="full"><span data-i18n="label.insurer">Your insurer</span><select data-searchable name="insurer" required><option value="" data-i18n="label.choose">Choose your insurer</option>{insurers.map(c=><option value={c.id} data-search={c.name_hi}>{c.name}</option>)}<option value="unlisted" data-i18n="label.unlisted">Other / not listed</option></select></label>
    <label class="full"><span data-i18n="label.type">What are you waiting for?</span><select name="requestType"><option value="discharge" data-i18n="type.discharge">Final discharge</option><option value="preauth" data-i18n="type.preauth">Cashless pre-authorisation</option><option value="enhancement" data-i18n="type.enhancement">Extra approval / enhancement</option></select></label>
    <label class="full"><span data-i18n="label.time">Submission date and time</span><input name="submittedAt" type="datetime-local" required /><small id="input-timezone"></small></label>
    <label class="full"><span data-i18n="label.tpa">TPA, if any</span><select data-searchable name="tpa"><option value="" data-i18n="label.noTpa">Not sure / handled by insurer</option>{tpas.map(c=><option value={c.id} data-search={c.name_hi}>{c.name}</option>)}</select><small data-i18n="label.tpaHint">The company that processes claims for your insurer; the hospital desk knows. Leave "Not sure" if you are unsure.</small></label>
    <label><span data-i18n="label.hospital">Hospital</span><input name="hospital" maxlength="100" autocomplete="off" /><small data-i18n="label.optional">Optional</small></label>
    <label><span data-i18n="label.city">City</span><input name="city" maxlength="70" autocomplete="address-level2" /><small data-i18n="label.optional">Optional</small></label>
    <div class="full"><p class="error" id="start-error" role="alert"></p><button class="button start-button" type="submit" disabled><span data-i18n="start.button">Start my clock</span><span aria-hidden="true">→</span></button><p class="fine-print" data-i18n="start.note">This records what you tell us. A written acknowledgement helps support it.</p><p class="fine-print"><a href="#local-cases" data-i18n="start.haveCase">Already have a case on another phone, or a backup file? Restore or receive it at the bottom of this page.</a></p></div>
   </form>
  </section>
  <aside><section class="card rights-card"><p class="section-number" data-i18n="rights.eyebrow">KNOW YOUR RIGHTS</p><h2 data-i18n="rights.title">What the rule says</h2><ol class="rights-list">{rights.map(r=><li><span data-rule-plain={r!.id}>{r!.plain_en}</span><blockquote>“{r!.quote}”</blockquote><a href={r!.source_url} target="_blank" rel="noopener noreferrer">{r!.paragraph} ↗</a></li>)}</ol></section><a class="death-link" href="/death/" data-i18n="death.link">A patient has died — help with release</a></aside>
 </div>
 <section id="dashboard" class="dashboard" hidden>
  <div class="dashboard-top"><h1 data-i18n="clock.title">Your cashless clock</h1><button class="text-button" id="edit-details" data-i18n="clock.edit">Correct details</button><a class="text-button" href="#local-cases" data-i18n="clock.cases">Saved cases &amp; backup</a></div>
  <p id="storage-error" class="error" role="alert"></p>
  <div class="dashboard-grid"><div class="stack">
   <section class="card clock-card" id="clock-card"><h2 id="clock-label">Time left in the rule's window</h2><div class="clock-digits" id="clock-digits" role="timer" aria-live="off">03:00:00</div><p class="clock-meta" id="clock-meta"></p><section id="what-now" aria-labelledby="what-now-title"><h3 id="what-now-title" data-i18n="clock.whatNow">What to do now</h3><ol class="what-now-steps"><li id="step-record" data-i18n="clock.stepRecord">1. Confirm receipt</li><li id="step-followup" data-i18n="clock.stepFollowup">2. Follow up</li><li id="step-escalate" data-i18n="clock.stepEscalate">3. Raise a grievance</li></ol><p class="status" id="clock-next" role="status"></p><a id="decision-next" class="text-button" hidden></a></section><div class="progress" aria-hidden="true"><span id="clock-progress"></span></div><p class="fine-print" data-i18n="clock.basis">Based on the submission time you entered. This is not independent proof.</p><p class="fine-print" id="enhancement-note" hidden data-i18n="clock.enhancement">No separate enhancement deadline has been verified.</p><button class="button lime" data-letter="lock"><span data-i18n="clock.lock">Lock the clock</span><span aria-hidden="true">↗</span></button><p class="lock-caption" data-i18n="clock.lockBody">Ask the desk to confirm the time and request ID in writing.</p></section>
   <section class="card"><h2 data-i18n="timeline.title">Your evidence timeline</h2><p data-i18n="timeline.subtitle">Keep query, document and call times together.</p><ol class="timeline-list" id="timeline-list"></ol>
    <form id="event-form" class="form-grid"><label><span data-i18n="timeline.type">What happened?</span><select name="type"><option value="query" data-i18n="timeline.query">Query raised</option><option value="documents" data-i18n="timeline.documents">Documents re-sent</option><option value="call" data-i18n="timeline.call">Call made</option><option value="ack" data-i18n="timeline.ack">Written acknowledgement received</option><option value="other" data-i18n="timeline.other">Other update</option></select></label><label><span data-i18n="timeline.at">When?</span><input name="at" type="datetime-local" required /></label><label class="full"><span data-i18n="timeline.note">Short note (avoid medical details)</span><input name="note" maxlength="300" autocomplete="off" /></label><p class="error full" id="event-error" role="alert"></p><button type="submit" class="button-secondary full" disabled data-i18n="timeline.add">Add timestamp</button></form>
    <div class="button-row"><button class="text-button" id="print-timeline" data-i18n="timeline.print">Save timeline as PDF</button><button class="text-button" id="export-timeline" data-i18n="timeline.export">Download a backup</button></div>
   </section>
   <section class="card" id="recovery-section"><h2 data-i18n="recovery.title">Charged extra for the wait?</h2><p data-i18n="recovery.body">Record extra room or nursing charges after discharge.</p><form id="recovery-form" class="form-grid"><label><span data-i18n="recovery.hours">Extra hours charged</span><input name="hours" type="number" min="0.1" max="2160" step="0.1" required /></label><label><span data-i18n="recovery.amount">Extra charges (₹)</span><input name="amount" type="number" min="1" max="10000000" step="0.01" required /></label><button type="submit" class="button-secondary full" disabled data-i18n="recovery.button">Prepare recovery demand</button></form></section>
  </div><aside class="stack">
   <section class="card"><h2 data-i18n="rights.title">What the rule says</h2><div id="active-rule" class="fine-print"></div><div class="action-list"><button class="button-secondary" data-letter="followup" data-i18n="clock.followup">Prepare a follow-up</button><button class="button-secondary" data-letter="gro" data-i18n="clock.gro">Prepare a GRO email</button><button class="button-secondary" data-letter="bima" data-i18n="clock.bima">Prepare a Bima Bharosa complaint</button><button class="button-secondary discharge-only" data-letter="billing" data-i18n="clock.billing">Note for the billing desk</button><button class="button-secondary" data-letter="protest" data-i18n="clock.protest">Receipt: paid under protest</button></div><a class="death-link" href="/death/" data-i18n="death.link">A patient has died — help with release</a></section>
   <section class="card"><h2 data-i18n="contact.title">Your verified contacts</h2><div id="contacts"></div></section>
   <section class="card"><h2 data-i18n="finished.title">Record the insurer's decision</h2><form id="finish-form" class="form-grid"><label class="full"><span data-i18n="finished.time">Decision time</span><input type="datetime-local" name="decidedAt" required /></label><label class="full"><span data-i18n="finished.outcome">Outcome</span><select name="outcome"><option value="approved" data-i18n="finished.approved">Approved</option><option value="partial" data-i18n="finished.partial">Partly approved</option><option value="rejected" data-i18n="finished.rejected">Rejected</option></select></label><p class="error full" id="finish-error" role="alert"></p><button type="submit" class="button-secondary full" disabled data-i18n="finished.save">Save decision</button></form></section>
  </aside></div>
  <section id="optin-section" class="card consent-box" hidden><h2 data-i18n="optin.title">Help make the wait visible</h2><p data-i18n="optin.body">{en['optin.body']}</p><h3 data-i18n="optin.summary">Fields you are choosing to share</h3><dl id="report-summary" class="report-summary"></dl><details id="report-exact"><summary data-i18n="optin.exact">Show exact data</summary><pre class="report-preview" id="report-preview"></pre></details><form id="optin-form"><label class="checkbox-label"><input type="checkbox" name="consent" required /><span data-i18n="optin.consent">I am 18 or older and agree to share these fields for the patient-reported Delay Index.</span></label><div class="button-row"><button type="submit" class="button-secondary" disabled data-i18n="optin.submit">Share this timestamp report</button><a href="/privacy/" data-i18n="privacy.link">Privacy & data</a></div><p class="status" id="optin-status" role="status"></p></form><section id="deletion-receipt" hidden><h3 data-i18n="optin.deletionCode">Your deletion code</h3><label class="sr-only" for="deletion-code" data-i18n="optin.deletionCode">Your deletion code</label><input id="deletion-code" readonly autocomplete="off" /><button class="button-secondary" id="copy-deletion-code" data-i18n="optin.copyCode">Copy deletion code</button><p id="deletion-saved" class="fine-print" data-i18n="optin.saved">Also saved on this device; you can erase from the Privacy page.</p><p id="deletion-copy-status" class="status" role="status"></p></section></section>
  <div class="button-row"><span class="fine-print" data-i18n="privacy.local">Saved only on this device</span><button class="text-button" id="erase-timeline" data-i18n="privacy.clear">Delete my local timeline</button></div>
 </section>
 <HospitalToolkits />
 <!-- Secondary tools stay below the clock: a first-time visitor should meet the form, not case management. -->
 <section class="card" id="unsaved-receipts" hidden aria-labelledby="unsaved-receipts-title"><h2 id="unsaved-receipts-title" data-i18n="optin.unsavedReceipts">Deletion codes not saved on this device</h2><div id="unsaved-receipt-list"></div></section>
 <section class="card" id="local-cases"><h2 data-i18n="cases.title">Cases on this device</h2><p class="fine-print" data-i18n="cases.private">No account. Each case and its attached deduction lines stay in this browser.</p><label><span data-i18n="cases.choose">Current case</span><select data-searchable id="case-select" disabled></select></label><div class="button-row"><button type="button" class="button-secondary" id="case-new" disabled data-i18n="cases.new">Create another case</button><button type="button" class="text-button" id="case-delete" disabled data-i18n="cases.delete">Delete selected case</button></div><p id="case-status" class="status" role="status"></p><p id="workflow-status" class="status" role="status"></p><div class="button-row" id="workflow-actions" hidden><button type="button" class="button-secondary" id="workflow-download" data-i18n="workflow.download">Download my unsaved draft</button><button type="button" class="button-secondary" id="workflow-load-latest" data-i18n="workflow.loadLatest">Load latest saved case</button></div><button type="button" id="case-raw-backup" class="text-button" hidden disabled data-i18n="cases.recover">Download preserved storage for recovery</button><details><summary data-i18n="backup.title">Restore a backup</summary><label><span data-i18n="backup.file">Choose a ClaimClock JSON backup (up to 1 MB)</span><input type="file" id="backup-file" accept="application/json,.json" disabled /></label><p class="fine-print" data-i18n="backup.private">The file stays on this device. Review the preview before saving it.</p><label><span data-i18n="backup.paste">Or paste backup JSON</span><textarea id="backup-paste" rows="5" autocomplete="off" spellcheck="false" disabled></textarea></label><button type="button" class="button-secondary" id="backup-paste-preview" disabled data-i18n="backup.previewPaste">Preview pasted backup</button><p id="backup-status" class="status" role="status"></p></details></section>
 <Transfer />
</div>
<dialog id="restore-dialog" aria-labelledby="restore-title"><h2 id="restore-title" data-i18n="backup.preview">Review this backup</h2><dl id="restore-summary" class="report-summary"></dl><p data-i18n="backup.choice">Import as a new case, or deliberately replace the case selected below.</p><label><span data-i18n="backup.target">Case to replace</span><select data-searchable id="restore-target"></select></label><div class="button-row"><button type="button" class="button" id="restore-new" disabled data-i18n="backup.new">Import as a new case</button><button type="button" class="button-secondary" id="restore-replace" disabled data-i18n="backup.replace">Replace selected case</button><button type="button" class="text-button" id="restore-cancel" disabled data-i18n="backup.cancel">Cancel</button></div><p id="restore-status" class="status" role="status"></p></dialog>
<LetterDialog />
<script>import '../lib/hospital';</script>
</Base>
<style>
 form [aria-invalid="true"],form[aria-invalid="true"]{outline:2px solid var(--red);outline-offset:3px;border-color:var(--red)}
</style>
