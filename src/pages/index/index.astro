---
import Base from '../../layouts/Base.astro';
import rows from '../../../data/nl48.json';
import contacts from '../../../data/contacts.json';
import sourceQa from '../../../research/nl48-m10-qa.json';
import Nl48Validation from '../../components/Nl48Validation.astro';
import {compareInsurer,shareText,providerKey} from '../../lib/index-comparison';
const reviews=sourceQa.checks.flatMap(check=>check.columns);
const insurers=contacts.filter(c=>c.kind==='insurer').map(c=>({...c,comparison:compareInsurer(rows,c.id,reviews)})).sort((a,b)=>a.name.localeCompare(b.name));
const covered=new Set(rows.map(r=>r.insurer_id));
---
<Base title="Discharge Delay Index — ClaimClock" description="Compare individual-policy discharge turnaround disclosures, with source periods, claim counts and TPA coverage clearly shown.">
 <div class="wrap"><section class="page-hero"><p class="eyebrow" data-i18n="index.eyebrow">PUBLIC DATA. A CLEARER PICTURE.</p><h1 data-i18n="index.title">The Discharge Delay Index</h1><p class="lead" data-i18n="comparison.intro">Compare published discharge times for individual policies. Open an insurer for the underlying TPA tables and sources.</p></section>
 <div class="notice"><p data-i18n="index.caution">A 2–6 hour bucket cannot tell us whether the 3-hour rule was met. These are disclosures, not a compliance ranking.</p><p data-i18n="index.sourceClock">The insurer's clock starts when the TPA receives the discharge bill. A family's wait may start earlier.</p></div>
 <div class="index-summary"><div><strong>{covered.size} / 32</strong><span data-i18n="comparison.coverage">insurers with numeric disclosures</span></div><div><strong>{rows.length}</strong><span data-i18n="comparison.rows">published source rows</span></div><div><strong data-i18n="comparison.date">10 October 2026</strong><span data-i18n="comparison.retrieved">retrieved</span></div></div>
 <div class="button-row"><a class="button-secondary" href="/data/nl48.csv" download>CSV ↓</a><a class="button-secondary" href="/data/nl48.json" download>JSON ↓</a><a href="/methodology/" data-i18n="index.method">Read the methodology</a><a href="/og/index.png" download data-i18n="comparison.card">Save share card</a></div>
 <section class="comparison-section"><h2 data-i18n="comparison.title">Individual policies · discharge</h2><p class="fine-print" data-i18n="comparison.scope">Each row uses the latest verified period available for that insurer. A single channel is not necessarily the whole insurer. Ranges show the lowest and highest reported channel shares; they are not insurer averages. Weighted shares appear only when every channel discloses its count. Unknown late buckets stay blank.</p>
 <div class="comparison-sort"><label for="index-sort" data-i18n="comparison.sort">Sort comparison</label><select id="index-sort"><option value="name" data-i18n="comparison.sortName">Insurer name</option><option value="lt1" data-i18n="comparison.sortLt1">Under 1 hour · highest first</option><option value="h1_2" data-i18n="comparison.sort12">1–2 hours · highest first</option><option value="h2_6" data-i18n="comparison.sort26">2–6 hours · highest first</option><option value="gt6" data-i18n="comparison.sortGt6">Over 6 hours · highest first</option><option value="period" data-i18n="comparison.sortPeriod">Period · newest first</option><option value="count" data-i18n="comparison.sortCount">Disclosed count · highest first</option></select></div>
 <p class="fine-print" data-i18n="index.review.explanation">Review flags identify unusual published distributions for a source check. They do not establish an error or a legal breach; a PDF recheck confirms transcription only.</p><p class="fine-print" data-i18n="comparison.sortNote">Range sorting uses the lower endpoint. Missing values appear last. This sorting does not rank legal compliance.</p>
 <p class="fine-print swipe-hint" data-i18n="comparison.swipe">Swipe the table sideways to see every column. The insurer name stays in view.</p>
 <div class="comparison-scroll" tabindex="0" data-i18n-aria-label="comparison.tableLabel" aria-label="Individual discharge comparison"><table class="comparison-table"><thead><tr><th data-i18n="comparison.insurer">Insurer</th><th data-i18n="comparison.lt1">&lt;1 hour</th><th data-i18n="comparison.h12">1–2 hours</th><th data-i18n="comparison.h26">2–6 hours</th><th data-i18n="comparison.gt6">&gt;6 hours</th><th data-i18n="comparison.period">Period</th><th data-i18n="comparison.count">Disclosed cashless count</th></tr></thead><tbody id="comparison-rows">{insurers.map(c=><tr data-insurer={c.id} data-name={c.name} data-period={c.comparison.period||''} data-count={c.comparison.count??''} data-lt1={c.comparison.shares[0]?.min??''} data-h1_2={c.comparison.shares[1]?.min??''} data-h2_6={c.comparison.shares[2]?.min??''} data-gt6={c.comparison.shares[3]?.min??''}><th scope="row"><a href={`/index/${c.id}/`}>{c.name} ↗</a><small><span data-i18n={`comparison.${c.comparison.mode}`}>{c.comparison.mode==='range'?'Channel range':c.comparison.mode==='weighted'?'Weighted channels':c.comparison.mode==='single'?'Single reported channel':'No comparable row'}</span>{c.comparison.channels>0&&<> · {c.comparison.channels} <span data-i18n="comparison.channels">channel(s)</span></>}</small>{c.comparison.validation.some(check=>check.result.flags.length>0)&&<small data-review-indicator><span data-i18n={c.comparison.validation.some(check=>check.result.flags.length>0&&!check.result.reviewedOn)?'index.review.pending':'index.review.verified'}>{c.comparison.validation.some(check=>check.result.flags.length>0&&!check.result.reviewedOn)?'Review flag · manual re-verification pending':'Review flag · PDF reverified'}</span></small>}{c.comparison.channels>0&&<details class="source-checks"><summary data-i18n="index.validation.sourceRows">Source row checks</summary>{c.comparison.validation.map(check=><div><strong data-i18n={providerKey(check.channel)}>{check.channel}</strong><Nl48Validation result={check.result} /></div>)}</details>}</th>{c.comparison.shares.map(v=><td><span data-share>{shareText(v)}</span>{v?.minChannels&&<details class="channel-endpoints" data-channel-endpoints><summary data-i18n="comparison.endpointChannels">Channel endpoints</summary><p><span data-i18n={v.min===v.max?'comparison.allAtValue':'comparison.lowerChannel'}>{v.min===v.max?'All at this value':'Lower endpoint'}</span>: {v.minChannels.map((name,i)=><>{i>0?'; ':''}<span data-i18n={providerKey(name)}>{name}</span></>)}</p>{v.min!==v.max&&<p><span data-i18n="comparison.upperChannel">Upper endpoint</span>: {v.maxChannels?.map((name,i)=><>{i>0?'; ':''}<span data-i18n={providerKey(name)}>{name}</span></>)}</p>}</details>}</td>)}<td>{c.comparison.period||'—'}</td><td>{c.comparison.count!==null?c.comparison.count.toLocaleString('en-IN'):<span data-i18n="comparison.undisclosed">Not disclosed</span>}</td></tr>)}</tbody></table></div></section>
 <p class="fine-print" data-i18n="index.missing">Missing or unparseable filings are listed in the coverage register.</p><div class="button-row"><a href="/data/filings.json" data-i18n="comparison.register">Read the coverage register ↗</a></div><div class="empty-note"></div></div>
 <style>
 .channel-endpoints,.source-checks{font-size:.7rem;font-weight:400;white-space:normal;line-height:1.5;margin-top:8px;min-width:125px;max-width:240px;overflow-wrap:anywhere}.channel-endpoints p,.source-checks>div{margin-top:9px}.source-checks :global(.fine-print){font-size:.7rem;margin-top:5px}
 </style>
 <script>
 const sort=document.querySelector<HTMLSelectElement>('#index-sort')!;
 sort.addEventListener('change',()=>{const body=document.querySelector('#comparison-rows')!;const rows=Array.from(body.querySelectorAll<HTMLTableRowElement>('tr'));const key=sort.value;
 rows.sort((a,b)=>{const av=a.dataset[key]??'',bv=b.dataset[key]??'';if(!av||!bv)return av?-1:bv?1:(a.dataset.name||'').localeCompare(b.dataset.name||'');const cmp=key==='name'?av.localeCompare(bv):key==='period'?bv.localeCompare(av):Number(bv)-Number(av);return cmp||(a.dataset.name||'').localeCompare(b.dataset.name||'');});rows.forEach(row=>body.append(row));});
 </script>
</Base>
