---
import Base from '../../layouts/Base.astro';
import Contacts from '../../components/Contacts.astro';
import rows from '../../../data/nl48.json';
import contacts from '../../../data/contacts.json';
import filings from '../../../data/filings.json';
export function getStaticPaths(){return contacts.filter(c=>c.kind==='insurer').map(contact=>({params:{insurer:contact.id},props:{contact}}));}
const {contact}=Astro.props;
const data=rows.filter(r=>r.insurer_id===contact.id);
const filing=filings.find(r=>r.insurer_id===contact.id);
const buckets=[['lt1h','<1 h'],['h1_2','1–2 h'],['h2_6','2–6 h'],['h6_12','6–12 h'],['h12_24','12–24 h'],['gt24h','>24 h']] as const;
---
<Base title={`${contact.name} — Discharge Delay Index`}>
 <div class="wrap"><section class="page-hero"><a href="/index/" class="fine-print" data-i18n="index.back">All insurers</a><p class="eyebrow" style="margin-top:24px">DISCHARGE DELAY INDEX</p><h1>{contact.name}</h1><p class="lead" data-i18n="index.sourceClock">The insurer's clock starts when the TPA receives the discharge bill. A family's wait may start earlier.</p></section>
 <div class="notice" data-i18n="index.caution">A 2–6 hour bucket cannot tell us whether the 3-hour rule was met. These are disclosures, not a compliance ranking.</div>
 <div class="index-columns"><section class="card"><h2 data-i18n="index.reported">What insurers report</h2><p data-i18n="index.units">Values are shown in the units published. Rounding is preserved. Different TPAs and periods are not combined.</p>
 <p class="fine-print">Coverage / कवरेज: {filing?.status || 'not verified'} · <a href="/data/filings.json">Read filing notes / जाँच के नोट ↗</a></p>{filing?.notes?.map(note=><p class="fine-print">{note}</p>)}
 {data.length===0&&<p class="empty-note" data-i18n="index.noData">No verified, parseable NL-48 row is available for this insurer yet.</p>}
 {['discharge','preauth'].map(type=><details open={type==='discharge'}><summary>{type==='discharge'?'Final discharge / अंतिम डिस्चार्ज':'Pre-authorisation / पूर्व-मंज़ूरी'} ({data.filter(r=>r.request_type===type).length})</summary>{data.filter(r=>r.request_type===type).map(row=><article class="row-card"><h3>{row.tpa}</h3><p class="meta">{row.period} · {row.policy_type==='individual'?'Individual / व्यक्तिगत':'Group / समूह'} · {row.unit}</p><div class="bar" aria-hidden="true" title="Published percentages; rounding can leave gaps or exceed the track.">{buckets.map(([key])=><span style={`width:${row.unit==='percent'?(row[key]??0):0}%;flex-shrink:0`}></span>)}</div><div class="values">{buckets.map(([key,label])=><div><span>{label}</span><strong>{row[key]===null?'—':row[key]}{row[key]!==null&&row.unit==='percent'?'%':''}</strong></div>)}</div><p class="fine-print">Sample / कुल संख्या: {row.sample_size??'not disclosed / नहीं दिया गया'} · Retrieved / जाँच: {row.retrieved_on}</p><a class="pdf-link" href={`${'document_url' in row && row.document_url ? row.document_url : row.source_url}#page=${row.source_page}`} target="_blank" rel="noopener noreferrer">Source PDF · p. {row.source_page} ↗</a></article>)}</details>)}
 </section><aside class="stack"><Contacts insurerId={contact.id} /><section class="card"><h2 data-i18n="index.patients">What patients report</h2><div class="patient-empty" id="patient-data" data-insurer={contact.id}><p data-i18n="index.empty">No publishable patient sample yet (minimum 10 per cell).</p></div><p class="fine-print">Opt-in, self-reported. Not independently verified. / स्वैच्छिक रिपोर्ट; स्वतंत्र पुष्टि नहीं।</p><button class="button-secondary" id="load-patients">Check latest reports / नई रिपोर्ट देखें</button><p class="status" id="patient-status" role="status"></p></section><section class="card"><h3>Keep your own record / अपना रिकॉर्ड रखें</h3><p>Save the request time. Ask the desk to confirm it in writing.</p><a class="button" href="/" data-i18n="start.button">Start my clock</a></section><section class="card"><h3>Share this disclosure</h3><div class="button-row"><button class="button-secondary" id="share-index" data-i18n="index.share">Share this page</button><a id="share-whatsapp" class="text-button" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><button class="text-button" id="share-card">Save share card / कार्ड सहेजें</button></div></section></aside></div>
 <div class="button-row"><a href="/methodology/" data-i18n="index.method">Read the methodology</a><a href="/data/nl48.csv" download data-i18n="index.download">Download the dataset</a></div><div class="empty-note"></div></div>
 <script>
  import {lang,t} from '../../lib/i18n';
  const container=document.querySelector<HTMLElement>('#patient-data')!;
  const shareText=()=>`${document.title}\n${t('index.caution')}\n${location.href}`;
  const whatsapp=document.querySelector<HTMLAnchorElement>('#share-whatsapp')!;
  const update=()=>whatsapp.href=`https://wa.me/?text=${encodeURIComponent(shareText())}`;update();window.addEventListener('languagechange',update);
  document.querySelector('#share-index')!.addEventListener('click',async()=>{try{if(navigator.share)await navigator.share({title:document.title,url:location.href});else{await navigator.clipboard.writeText(location.href);document.querySelector('#patient-status')!.textContent=t('letter.copied');}}catch{}});
  document.querySelector('#load-patients')!.addEventListener('click',async()=>{try{
   const r=await fetch(`/api/aggregates?insurer=${encodeURIComponent(container.dataset.insurer!)}`);if(!r.ok)throw Error();
   const result=await r.json() as {rows:{n:number;request_type:string;period:string;total_minutes:number;beyond_window:number;updated_at:string}[]};
   const rows=result.rows.filter(row=>row.n>=10);if(!rows.length)return;
   container.replaceChildren();for(const row of rows){const p=document.createElement('p');p.textContent=`${row.request_type} · ${row.period}: n=${row.n}; mean ${(row.total_minutes/row.n).toFixed(0)} min; beyond window ${row.beyond_window}/${row.n}. Updated ${row.updated_at}`;container.append(p);}
  }catch{document.querySelector('#patient-status')!.textContent=lang()==='hi'?'नई रिपोर्ट उपलब्ध नहीं। प्रकाशित खुलासे ऑफ़लाइन भी काम करते हैं।':'Live reports are unavailable. Published disclosures remain available.';}});
  document.querySelector('#share-card')!.addEventListener('click',()=>{
   const canvas=document.createElement('canvas');canvas.width=1200;canvas.height=630;const ctx=canvas.getContext('2d')!;
   ctx.fillStyle='#f6f5ef';ctx.fillRect(0,0,1200,630);ctx.fillStyle='#183f35';ctx.font='bold 35px sans-serif';ctx.fillText('ClaimClock / Discharge Delay Index',70,95);ctx.font='bold 48px sans-serif';
   const title=document.title.split(' — ')[0];let y=210;let line='';for(const word of title.split(' ')){if(ctx.measureText(line+word).width>1040){ctx.fillText(line,70,y);line='';y+=65;}line+=word+' ';}ctx.fillText(line,70,y);
   ctx.font='27px sans-serif';ctx.fillText('What insurers report. Source-linked NL-48 disclosures.',70,380);ctx.fillText('The 2–6 hour bucket cannot show 3-hour compliance.',70,440);ctx.font='20px sans-serif';ctx.fillText(location.href,70,550);
   canvas.toBlob(blob=>{if(!blob)return;const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`claimclock-${container.dataset.insurer}.png`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);});
  });
 </script>
</Base>
