{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claimclock",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "17 2 * * *",
      "43 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claimclock",
      "database_id": "495ed4e1-7e8a-4d31-a1f9-a3c21987d0f8",
      "migrations_dir": "migrations"
    }
  ]
}
