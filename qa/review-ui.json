  "findings": [
    {
      "id": "UI-01",
      "severity": "medium",
      "title": "Short available viewport hides every insurer result",
      "status": "fixed_in_source_verified_not_yet_public_retested",
      "build_observed": "e1e509d30ac97912",
      "engines": [
        "Chromium",
        "WebKit"
      ],
      "reproduction": [
        "Use a fresh 667×200 CSS viewport and open the home insurer picker.",
        "Search health.",
        "Press ArrowDown or try to select a result by touch/pointer."
      ],
      "actual": "The public dialog list is 8px high; no result center is visible/hit-testable. ArrowDown focuses a clipped row. WebKit also scrolls the header partly out of view.",
      "impact": "A very short viewport cannot expose a usable option through the picker. This is directly reproduced by viewport sizing, not asserted as a tested physical phone keyboard.",
      "source_cause": "Fixed-height header/search/count/footer consume all flex space; visualViewport height was applied without compact chrome.",
      "fix": "At visualViewport height ≤300px, compact title/close and search stay visible, result rows remain ≥48px, count status and privacy hint remain in the accessibility tree but are visually clipped. Inset uses the actual visualViewport height/offset.",
      "verification": "3 focused browser tests passed in each engine on source4321: 200px height at667/320 widths, visible hit-testable result, keyboard selection/focus containment, simulated keyboard inset/restoration, and keeping a focused final option visible after shrinking700→200px.",
      "before_screenshots": [
        "qa/screenshots/review-ui-chromium-short.png",
        "qa/screenshots/review-ui-webkit-short.png"
      ],
      "after_screenshots": [
        "qa/screenshots/review-ui-chromium-667-compact-after.png",
        "qa/screenshots/review-ui-chromium-320-compact-after.png",
        "qa/screenshots/review-ui-webkit-667-compact-after.png",
        "qa/screenshots/review-ui-webkit-320-compact-after.png"
      ],
      "additional_resize_reproduction": "After opening at667×700, ArrowDown then End, resizing to667×200 also left the final focused row below the clipped list. viewport() now scrolls a focused result into view after height changes; new third regression passes both engines."
    },
    {
      "id": "UI-02",
      "severity": "medium",
      "title": "Language switch exits saved-case editing and discards unsaved changes on reopening",
      "status": "fixed_by_workflow_agent_independently_verified_in_source_not_yet_public_retested",
      "build_observed": "e1e509d30ac97912",
      "engines": [
        "Chromium",
        "WebKit"
      ],
      "reproduction": [
        "Start a synthetic Care case with hospital Synthetic saved hospital.",
        "Choose Edit details, change hospital to Synthetic unsaved correction without submitting.",
        "Click हिन्दी; the edit form is hidden and dashboard shown.",
        "Click Edit details again."
      ],
      "actual": "The hospital field reverts to Synthetic saved hospital. The draft temporarily remains in the hidden form after the language click, then populateDetails overwrites it on reopening.",
      "impact": "Unsaved editing is lost during a normal language-switch workflow. Saved case data is not changed.",
      "source_cause": "languagechange calls render(), which derives form visibility only from a saved timeline; reopening always populates saved values.",
      "screenshots": [
        "qa/screenshots/review-ui-chromium-language-edit.png",
        "qa/screenshots/review-ui-webkit-language-edit.png"
      ],
      "verification": "Independent repeat in Chromium and WebKit: language switch preserves visible edit form, typed hospital, hidden dashboard and byte-for-byte unchanged saved local case data.",
      "after_screenshots": [
        "qa/screenshots/review-ui-chromium-language-edit-after.png",
        "qa/screenshots/review-ui-webkit-language-edit-after.png"
      ]
    }
  ],
  "diagnostics_not_classified_as_user_bugs": [
    {
      "id": "UI-D1",
      "title": "Open-list current marker is stale after a controlled programmatic value update",
      "reproduction": "Choose Care, reopen insurer picker, set native select.value=hdfc-ergo and dispatch window pickerrefresh.",
      "actual": "Native value and trigger show HDFC ERGO, but the open list still marks Care aria-current=true. Closing/reopening refreshes.",
      "limitation": "This uses page.evaluate; no corresponding ordinary user path while the modal is open was established. Not counted as a confirmed production workflow bug and not changed.",
      "screenshots": [
        "qa/screenshots/review-ui-chromium-late-refresh.png",
        "qa/screenshots/review-ui-webkit-late-refresh.png"
      ]
    }
  ],
  "passed_checks": [
    "At320×460, query health displays usable rows without horizontal overflow in Chromium and WebKit.",
    "At640×450 reflow-equivalent viewport, both engines expose usable rows and Escape restores trigger focus.",
    "Actual Chromium browser zoom factor2 was confirmed with chrome.tabs.getZoom after chrome.tabs.setZoom; DOM geometry, hit testing and Escape focus passed. Screenshot compositor limitation is recorded separately.",
    "Submitting an entirely empty rejection form exposes the insurer error and focuses the next visible invalid date field; no nonfocusable-control console error, all invalid fields remain recoverable.",
    "Escape from the controlled open-list refresh returns focus to the trigger in both engines."
  ],
